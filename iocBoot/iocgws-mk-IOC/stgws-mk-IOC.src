$(LINUX_ONLY)#!/gem_base/epics/ioc/gws_mk/bin/linux-x86_64/gws-mk-IOC

cd /gem_base/epics/ioc/gws_mk
epicsEnvSet("IOCSH_PS1","gws-mk-ioc> ")

## Register all support components
dbLoadDatabase("dbd/gws-mk-IOC.dbd")
gws_mk_IOC_registerRecordDeviceDriver(pdbbase)

## Load record instances
#dbLoadRecords("db/iocAdminSoft.db"," IOC=ws:iocStats,TODFORMAT=%m/%d/%Y %H:%M:%S")

# Get IP numbers from configuration space.
< /gemsoft/etc/rtconfig/gws/start_IPconfig

epicsEnvSet ("STREAM_PROTOCOL_PATH", "/gemsoft/etc/rtconfig/gws")

dbLoadRecords("db/gwsTop.db", "top=tws:,ADDR=0,SCAN=10 second,site_vaisala_p=NoTdf")
dbLoadRecords("db/gwsSadTop.db", "top=tws:")

iocInit

pvload "/gemsoft/etc/rtconfig/gws/gwsInitMK.pv", "top=tws:"

## Start any sequence programs
#seq(sncxxx, "user=mrippa")
