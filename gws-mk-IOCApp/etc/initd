#! /bin/bash
#
# procservd       procServ daemon initd
#
# chkconfig: 345 80 20
# description: procServ daemon initd.
#

### BEGIN INIT INFO
# Provides:          procservd
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Should-Start:      $local_fs
# Should-Stop:       $local_fs
# Default-Start:     3 4 5
# Default-Stop:      0 1 2 6
# Short-Description: procServ daemon initd
# Description:       procServ daemon initd
### END INIT INFO


PATH=/sbin:/bin:/usr/sbin:/usr/bin

CONFDIR=/etc/procserv-initd/config

. /etc/init.d/functions

die () {
	echo "$1"
   exit 1
}

NAME=$(basename $0)
PROCDAEMON=${NAME#[SK][0-9][0-9]}

#PROCSERV=/usr/bin/procServ
PROCSERV=/gem_sw/epics/R3.14.12.4/extensions/bin/linux-x86_64/procServ

GLOBCONF="$CONFDIR/global.cfg"
PROCCONF="$CONFDIR/$PROCDAEMON.cfg"

PID=/var/run/procservd-$PROCDAEMON.pid

[ -f "$PROCCONF" ] || die "Config not found: $PROCCONF"

NAME=invalid
PORT=invalid
unset USER
unset HOST

if [ -f "$GLOBCONF" ]; then
  . $GLOBCONF
fi

. $PROCCONF

[ "$NAME" = "invalid" ] && die "Config does not have NAME"
[ "$NAME" = "$PROCDAEMON" ] || die "Config NAME ($NAME) mismatch ($PROCDAEMON)"
[ "$PORT" = "invalid" ] && die "Config needs port"

if [ -n "$HOST" ]; then
  if [ "$HOST" != "$(hostname -s)" -a "$HOST" != "$(hostname -f)" ]; then
    die "Config HOST ($HOST) mismatch host '$(hostname -f)'"
  fi
fi

check_status() {
  if [ "$1" = "-q" ];then
    status -p "$PID" "procServ" "$PROCDAEMON" &>/dev/null
  else
    status -p "$PID" "procServ" "$PROCDAEMON"
  fi
  return $?
}

# Verify that user $1 exists on this system
check_user() {
  id "$USER" &>/dev/null || die "USER ($USER) is invalid"
}

PROCARGS="-q -c $PROCDIR -i ^D^C^] -p $PID -n $PROCDAEMON --allow"

# For debugging
if [ ] ; then
  echo '----'
  echo "PID=$PID"
  echo "PROCSERV=$PROCSERV"
  echo "CONFDIR=$CONFDIR"
  echo "PROCDAEMON=$PROCDAEMON"
  echo "GLOBCONF=$GLOBCONF"
  echo "PROCCONF=$PROCCONF"
  echo "NAME=$NAME"
  echo "USER=$USER"
  echo "PORT=$PORT"
  echo "HOST=$HOST"
  echo "PROCDIR=$PROCDIR"
  echo "PROCCMD=$PROCCMD"
  echo "PROCARGS=$PROCARGS"
  echo "PROCUSRARGS=$PROCUSRARGS"
  echo '----'
fi

case "$1" in

start)
	check_user
   
	echo -n $"Starting procservd $PROCDAEMON "
   
	check_status -q && die ".. already running"
   
	# Needed so that the pid file can be written by $USER
	# procServ will put in the correct pid
	touch $PID || die "Failed to create pid file"
	chown "$USER" $PID || die "Failed to chmod pid file"

	cd /tmp
	daemon --user "$USER" $PROCSERV $PROCARGS $PROCUSRARGS $PORT $PROCCMD
	;;
stop)
	echo -n $"Stopping procservd $PROCDAEMON: "
	
	killproc -p $PID $PROCSERV >& /dev/null
	RETVAL=$?
	[ $RETVAL -eq 0 ] && rm -f "$PID"
	if [ -n "`pidof $PID`" ] ; then
		failure "procservd $PROCDAEMON shutdown"
	else
		success "procservd $PROCDAEMON shutdown"
	fi
	echo
	exit $RETVAL
	;;
status)
	echo -n "Status procservd $PROCDAEMON: "
	check_status
	exit $?
	;;
restart)
	$0 stop
	sleep 2
	$0 start
	;;
reload)
	echo -n "Attempting to reload $PROCDAEMON: "
	killproc -p $PID $PROCSERV -HUP
	echo
	;;
*)
	echo $"Usage: $0 {start|stop|status|restart}"
	exit 3
   ;;
esac

exit 0
